{
  "schema_version": 1,
  "selection": {
    "primary_metric": "best_validation_balanced_accuracy",
    "primary_mode": "max",
    "tie_breakers": [
      {
        "metric": "best_validation_loss",
        "mode": "min"
      },
      {
        "metric": "best_validation_macro_f1",
        "mode": "max"
      },
      {
        "metric": "candidate_id",
        "mode": "asc"
      }
    ]
  },
  "search_spaces": [
