          0.001
        ],
        "--weight-decay": [
          0.0,
          0.001
        ]
      }
    },
    {
      "name": "flatten",
      "fixed_args": {
        "--pooling": "flatten"
      },
      "grid": {
        "--head-lr": [
          0.00003,
          0.0001
        ],
        "--weight-decay": [
          0.001,
          0.01
        ]
      }
    }
  ]
}
